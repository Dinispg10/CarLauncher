<?xml version="1.0" encoding="utf-8"?>
<!-- Ecrã "A tocar". Medidas em px num ecrã de 600px de altura; o ScaleFrame ajusta ao ecrã real. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF0B0D10"
    android:orientation="vertical"
    android:paddingStart="40px"
    android:paddingTop="20px"
    android:paddingEnd="40px"
    android:paddingBottom="36px">

    <!-- Barra de cima -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56px"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/btn_back"
            android:layout_width="wrap_content"
            android:layout_height="52px"
            android:background="@drawable/pill_bg"
            android:clickable="true"
            android:contentDescription="Voltar ao início"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16px"
            android:paddingEnd="22px">

            <ImageView
                android:layout_width="22px"
                android:layout_height="22px"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_back" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10px"
                android:tag="w600"
                android:text="Início"
                android:textColor="#FFF2F3F5"
                android:textSize="17px" />
        </LinearLayout>

        <View
            android:layout_width="0px"
            android:layout_height="1px"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/source_chip"
            android:layout_width="wrap_content"
            android:layout_height="48px"
            android:background="@drawable/chip_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:maxLines="1"
            android:paddingStart="18px"
            android:paddingEnd="18px"
            android:tag="w600"
            android:textColor="#FFC9CDD3"
            android:textSize="16px" />
    </LinearLayout>

    <!-- Capa + informação -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0px"
        android:layout_marginTop="20px"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/art_box"
            android:layout_width="380px"
            android:layout_height="380px"
            android:background="@drawable/card_bg">

            <ImageView
                android:id="@+id/art_placeholder"
                android:layout_width="120px"
                android:layout_height="120px"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_music"
                android:tag="accent_tint" />

            <ImageView
                android:id="@+id/art"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Capa do álbum"
                android:scaleType="centerCrop"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0px"
            android:layout_height="wrap_content"
            android:layout_marginStart="48px"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/np_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.14"
                android:tag="w700 accent_text"
                android:text="A TOCAR"
                android:textSize="14px" />

            <TextView
                android:id="@+id/np_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10px"
                android:ellipsize="end"
                android:letterSpacing="0"
                android:maxLines="2"
                android:tag="w600"
                android:text="Nada a tocar"
                android:textColor="#FFF2F3F5"
                android:textSize="49px" />

            <TextView
                android:id="@+id/np_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10px"
                android:ellipsize="end"
                android:maxLines="1"
                android:tag="w500"
                android:text="Ponha música no telemóvel"
                android:textColor="#FF9AA0A6"
                android:textSize="24px" />

            <TextView
                android:id="@+id/btn_access"
                android:layout_width="wrap_content"
                android:layout_height="56px"
                android:layout_marginTop="24px"
                android:background="@drawable/pill_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="26px"
                android:paddingEnd="26px"
                android:tag="w600"
                android:text="Ativar acesso"
                android:textColor="#FFF2F3F5"
                android:textSize="19px"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/progress_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28px"
                android:orientation="vertical">

                <FrameLayout
                    android:id="@+id/progress_track"
                    android:layout_width="match_parent"
                    android:layout_height="24px">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="6px"
                        android:layout_gravity="center_vertical"
                        android:background="@drawable/track_bg" />

                    <View
                        android:id="@+id/progress_fill"
                        android:layout_width="0px"
                        android:layout_height="6px"
                        android:layout_gravity="center_vertical|start"
                        android:tag="accent_bar" />

                    <View
                        android:id="@+id/progress_thumb"
                        android:layout_width="18px"
                        android:layout_height="18px"
                        android:layout_gravity="center_vertical|start"
                        android:background="@drawable/thumb_bg" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6px"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/time_pos"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:tag="w500"
                        android:text="0:00"
                        android:textColor="#FF9AA0A6"
                        android:textSize="16px" />

                    <View
                        android:layout_width="0px"
                        android:layout_height="1px"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/time_dur"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:tag="w500"
                        android:text="0:00"
                        android:textColor="#FF9AA0A6"
                        android:textSize="16px" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28px"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/np_prev"
                    android:layout_width="72px"
                    android:layout_height="72px"
                    android:background="@drawable/btn_round_bg"
                    android:clickable="true"
                    android:contentDescription="Anterior"
                    android:focusable="true"
                    android:padding="22px"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_prev" />

                <ImageView
                    android:id="@+id/np_play"
                    android:layout_width="96px"
                    android:layout_height="96px"
                    android:layout_marginStart="22px"
                    android:clickable="true"
                    android:contentDescription="Reproduzir ou pausar"
                    android:focusable="true"
                    android:padding="30px"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_play_dark"
                    android:tag="accent_bg" />

                <ImageView
                    android:id="@+id/np_next"
                    android:layout_width="72px"
                    android:layout_height="72px"
                    android:layout_marginStart="22px"
                    android:background="@drawable/btn_round_bg"
                    android:clickable="true"
                    android:contentDescription="Seguinte"
                    android:focusable="true"
                    android:padding="22px"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_next" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
